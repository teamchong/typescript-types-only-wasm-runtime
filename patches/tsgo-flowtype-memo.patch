 func (c *Checker) getTypeFromTypeNode(node *ast.Node) *Type {
-	return c.getConditionalFlowTypeOfType(c.getTypeFromTypeNodeWorker(node), node)
+	// getConditionalFlowTypeOfType walks node's ancestor chain up to the enclosing
+	// statement on every call - O(nesting depth). resolvedType (from the worker) is
+	// already memoized per node and the ancestor walk is a pure function of the node,
+	// so the flow type is too: memoize it. On doom's deeply nested conditional types
+	// this turns an O(depth) re-walk per node into O(1) after the first.
+	links := c.typeNodeLinks.Get(node)
+	if links.resolvedFlowType != nil {
+		return links.resolvedFlowType
+	}
+	result := c.getConditionalFlowTypeOfType(c.getTypeFromTypeNodeWorker(node), node)
+	links.resolvedFlowType = result
+	return result
 }
 
